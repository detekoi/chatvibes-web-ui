# ==============================================================================
# WildcatTTS Web UI - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local development.
# Fill in your own values for Twitch credentials, API keys, and endpoints.
#
# In production (Firebase Cloud Functions 2nd Gen), sensitive secrets are mounted
# from Google Cloud Secret Manager as specified in firebase.json.
# ==============================================================================

# ------------------------------------------------------------------------------
# Twitch OAuth & API Credentials
# ------------------------------------------------------------------------------
# Twitch application client ID and secret from Twitch Developer Console:
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID="your_twitch_client_id_here"
TWITCH_CLIENT_SECRET="your_twitch_client_secret_here"

# OAuth callback redirect URI (must match the redirect URL registered in Twitch console)
# Local: http://localhost:5001/<project-id>/us-central1/webUi/auth/twitch/callback
# Prod:  https://us-central1-<project-id>.cloudfunctions.net/webUi/auth/twitch/callback
CALLBACK_URL="https://us-central1-chatvibestts.cloudfunctions.net/webUi/auth/twitch/callback"

# Optional Twitch bot username
TWITCH_BOT_USERNAME="your_bot_username"

# ------------------------------------------------------------------------------
# Application & Session Settings
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens (or JWT_SECRET)
JWT_SECRET_KEY="your_jwt_secret_key_here"

# Frontend URL used for CORS validation and post-authentication redirects
# Local: http://localhost:5002
# Prod:  https://chatvibestts.web.app
FRONTEND_URL="https://chatvibestts.web.app"
FRONTEND_URL_CONFIG="https://chatvibestts.web.app"

# Base URL for the OBS browser source overlay
OBS_BROWSER_BASE_URL="https://chatvibes-tts-service-h7kj56ct4q-uc.a.run.app"

# URL for the TTS Bot backend service
TTS_BOT_URL="https://chatvibes-tts-service-h7kj56ct4q-uc.a.run.app"

# Google Cloud project ID
GCLOUD_PROJECT="chatvibestts"

# ------------------------------------------------------------------------------
# Channel Access Control / Allowlist
# ------------------------------------------------------------------------------
# Direct comma-separated list of allowed channels/broadcasters for dev testing
TWITCH_CHANNELS="your_channel_name"
ALLOWED_CHANNELS="your_channel_id_or_name"

# Google Cloud Secret Manager resource path for the allowed channels list (production)
ALLOWED_CHANNELS_SECRET_NAME="projects/chatvibestts/secrets/allowed-channels/versions/latest"

# ------------------------------------------------------------------------------
# TTS Providers & API Keys
# ------------------------------------------------------------------------------
# 302.ai API key for Minimax Speech TTS model (speech-2.8-turbo)
# In production, this is loaded from Secret Manager as `302_KEY`
T302_API_KEY="sk-your_302_ai_api_key_here"
# 302_KEY="sk-your_302_ai_api_key_here"

# Optional: 302.ai API endpoint override (defaults to https://api.302.ai/minimaxi/v1/t2a_v2)
# T302_API_ENDPOINT="https://api.302.ai/minimaxi/v1/t2a_v2"

# Wavespeed API key for TTS voice preview generation / legacy voices
WAVESPEED_API_KEY="your_wavespeed_api_key_here"

# ------------------------------------------------------------------------------
# Development & Emulator Flags
# ------------------------------------------------------------------------------
# Set to 1 in local development/emulator to load secrets from environment variables
# instead of Google Cloud Secret Manager
# USE_ENV_SECRETS="1"
