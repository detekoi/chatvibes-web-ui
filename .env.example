# WildcatTTS Web UI - repo-root environment template
#
# This file is for the helper scripts in scripts/ ONLY (they call dotenv.config()
# from the repo root). The Cloud Function does not read it -- see
# functions/.env.example for that.
#
# Copy to .env (gitignored) and fill in. Use DEV provider keys here: these scripts
# generate real, billable TTS audio.

# -- 302.ai (primary TTS provider) --
# DEV key. Production uses a separate key in Secret Manager as `302_KEY`
# (labelled env=prod). Never add this dev key as a version of that secret.
T302_API_KEY=your_302ai_dev_api_key_here

# Optional: override the default 302.ai endpoint
# T302_API_ENDPOINT=https://api.302.ai/minimaxi/v1/t2a_v2

# -- Wavespeed AI (fallback TTS provider) --
WAVESPEED_API_KEY=your_wavespeed_dev_api_key_here
