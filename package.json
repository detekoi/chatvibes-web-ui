{
  "name": "wildcat-tts-web-ui",
  "version": "1.0.0",
  "type": "module",
  "description": "WildcatTTS Web UI",
  "main": "scripts/generate-voice-previews.js",
  "scripts": {
    "generate-voices": "node scripts/generate-voice-previews.js",
    "test-api": "node scripts/test-api.js",
    "build:frontend": "node scripts/build-frontend.js",
    "watch:frontend": "node scripts/build-frontend.js --watch",
    "typecheck:frontend": "tsc --noEmit -p public/tsconfig.json",
    "i18n:extract": "node scripts/extract-i18n.js",
    "i18n:validate": "node scripts/validate-i18n.js",
    "test:i18n": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run check:design-system && npm run typecheck:frontend && npm run i18n:validate && npm run test:i18n",
    "css:baseline": "node scripts/css-snapshot.mjs --save",
    "css:check": "node scripts/css-snapshot.mjs --check",
    "sync:design-system": "node scripts/sync-design-system.mjs",
    "check:design-system": "node scripts/sync-design-system.mjs --check"
  },
  "keywords": [
    "tts",
    "voice",
    "wavespeed",
    "chatvibes"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "lucide": "^1.31.0",
    "parse5": "^7.3.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0"
  }
}
