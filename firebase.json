{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "hub": {
      "port": 4400
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "secretEnvironmentVariables": [
        {
          "key": "TWITCH_CLIENT_ID",
          "secret": "twitch-client-id"
        },
        {
          "key": "TWITCH_CLIENT_SECRET",
          "secret": "twitch-client-secret"
        },
        {
          "key": "JWT_SECRET_KEY",
          "secret": "jwt-secret-key"
        },
        {
          "key": "GEMINI_API_KEY",
          "secret": "GEMINI_API_KEY"
        }
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "src/**/*.ts",
        "index.ts",
        "**/*.test.ts",
        "**/__tests__/**",
        "tsconfig.json",
        "jest.config.js",
        "coverage"
      ],
      "predeploy": [
        "cp ../tts-twitch/src/components/tts/tts-config.json functions/src/services/tts-config.json 2>/dev/null || echo '⚠️  tts-twitch not found as sibling — using committed tts-config.json'",
        "cp ../tts-twitch/src/components/tts/gemini-voices.json functions/src/services/gemini-voices.json 2>/dev/null || echo '⚠️  tts-twitch not found as sibling — using committed gemini-voices.json'",
        "cp ../tts-twitch/src/components/tts/minimax-to-gemini-voices.json functions/src/services/minimax-to-gemini-voices.json 2>/dev/null || echo 'ℹ️  no MiniMax voice map in tts-twitch — using the committed one, if any'",
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "predeploy": [
      "npm run build:frontend"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      ".env",
      "public/js/**/*.ts",
      "public/js/**/*.js.map"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "webUi"
      },
      {
        "source": "/auth/**",
        "function": "webUi"
      },
      {
        "source": "/s/**",
        "function": "webUi"
      }
    ]
  }
}